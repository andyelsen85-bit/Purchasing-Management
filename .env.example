# Copy this file to `.env` (in the same directory as docker-compose.yml) and
# replace the value below with a strong random secret. The app refuses to
# start in production if SESSION_SECRET is shorter than 32 characters or
# matches a known placeholder.
#
# Generate one with either:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Independent AES-256-GCM key for SMTP, LDAP bind, and AD FS secrets at rest.
# Production requires exactly 64 hexadecimal characters (32 random bytes):
#   openssl rand -hex 32
# Keep this stable and separate from SESSION_SECRET.
SETTINGS_ENCRYPTION_KEY=replace-with-64-hex-characters

# Production LDAP must use certificate-verified LDAPS or StartTLS. A temporary
# exception for an incident/lab must be separately deployed, reasoned, and
# time-boxed; these values are never editable in the web settings page.
LDAP_TLS_INSECURE_EXCEPTION_REASON=
LDAP_TLS_INSECURE_EXCEPTION_EXPIRES_AT=

# Plaintext legacy backup restore is rejected in production. If a legacy
# import is unavoidable, deploy a short-lived reason and ISO-8601 expiry,
# then remove both values immediately after the audited restore.
BACKUP_LEGACY_EXCEPTION_REASON=
BACKUP_LEGACY_EXCEPTION_EXPIRES_AT=

# Optional Microsoft AD FS OpenID Connect fallback configuration. Values saved
# by an administrator in Settings take precedence over these variables.
# AD FS 2016+ / 2019 / 2022 OIDC registration is supported.
ADFS_ENABLED=false
ADFS_DISPLAY_NAME=Microsoft AD FS
ADFS_ISSUER=https://adfs.example.invalid/adfs
ADFS_AUTHORITY=
ADFS_DISCOVERY_URL=
ADFS_CLIENT_ID=replace-with-registered-client-id
# Public clients leave this blank. Confidential clients should use a secret
# supplied through the deployment secret manager, not source control.
ADFS_CLIENT_SECRET=
ADFS_REDIRECT_URI=
ADFS_SCOPES=openid profile email
ADFS_USERNAME_CLAIM=preferred_username
ADFS_EMAIL_CLAIM=email
ADFS_DISPLAY_NAME_CLAIM=name
# Optional PEM CA for a private AD FS PKI (include BEGIN/END CERTIFICATE).
ADFS_CA_PEM=
